#!/bin/bash
# =============================================================================
# Optfile for production regional / IW alignment runs:
#   ifx (Intel Fortran) + Intel MPI from conda env mitgcm-intel.
#   Single-threaded; relies on Intel runtime in
#   ${NETCDF_PREFIX}/lib at execution time.
# =============================================================================

CC=icx
FC=ifx
F90C=ifx
LINK=$F90C

CONDA_ENV=${NETCDF_PREFIX:-${CONDA_PREFIX:?set NETCDF_PREFIX or activate the build environment}}

# Force system cpp + -P so traditional MITgcm cpp markers are stripped before
# Fortran compilation. The conda gcc cpp emits "# 1 ..." line markers without
# -P, which ifx 2024 rejects with "error #6218 statement positioned incorrectly".
CPP="/usr/bin/cpp -traditional -P"

INCLUDES="-I${CONDA_ENV}/include"
LIBS="-L${CONDA_ENV}/lib -lnetcdff -lnetcdf"

DEFINES='-DWORDLENGTH=4'
F90FIXEDFORMAT='-fixed -Tf'
EXTENDED_SRC_FLAG='-132'
GET_FC_VERSION="--version"
OMPFLAG='-qopenmp'

NOOPTFLAGS='-O0 -g'
NOOPTFILES=''

CFLAGS="-O3 -ip -m64 -fPIC"
FFLAGS="$FFLAGS -m64 -convert big_endian -assume byterecl"
FFLAGS="$FFLAGS -mcmodel=medium"
FFLAGS="$FFLAGS -W0 -WB"

if test "x$IEEE" = x ; then
    FOPTIM='-O2 -align -fp-model source -xHost'
else
    FOPTIM="-O0 -fp-model precise"
fi

F90FLAGS=$FFLAGS
F90OPTIM=$FOPTIM
